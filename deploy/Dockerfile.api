FROM node:22-bookworm-slim
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY packages/execution-trace/package.json packages/execution-trace/package.json
RUN pnpm install --frozen-lockfile --prod --filter @codeflow/api...
COPY apps/api apps/api
COPY packages/execution-trace packages/execution-trace
ENV NODE_ENV=production API_HOST=0.0.0.0 API_PORT=4000
USER node
EXPOSE 4000
CMD ["pnpm", "--filter", "@codeflow/api", "start"]
