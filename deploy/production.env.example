NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
MONGODB_URI=mongodb://mongo:27017/codeflow_visualizer
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret
WEB_ORIGIN=https://codeflow.example
EXECUTION_SERVICE_URL=http://isolated-execution.internal:4100
EXECUTION_SERVICE_SECRET=replace-with-a-different-32-character-secret
EXECUTION_ALLOW_RESTRICTED_DEMO=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
CODEFLOW_STRUCTURED_LOGS=true
PASSWORD_RESET_WEBHOOK_URL=https://mailer.example/codeflow/password-reset
PASSWORD_RESET_WEBHOOK_SECRET=replace-with-a-24-character-webhook-secret
PASSWORD_RESET_PAGE_URL=https://codeflow.example
