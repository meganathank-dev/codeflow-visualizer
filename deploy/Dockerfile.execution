FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    openjdk-17-jdk-headless \
    python3 \
    python-is-python3 \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/execution/package.json apps/execution/package.json
COPY packages/execution-trace/package.json packages/execution-trace/package.json
COPY packages/visualizer-core/package.json packages/visualizer-core/package.json

RUN pnpm install --frozen-lockfile --prod --filter @codeflow/execution...

COPY apps/execution apps/execution
COPY packages/execution-trace packages/execution-trace
COPY packages/visualizer-core packages/visualizer-core

ENV NODE_ENV=development \
  EXECUTION_HOST=0.0.0.0 \
  EXECUTION_PORT=4100 \
  EXECUTION_RESTRICTED_DEMO=true

USER node

EXPOSE 4100

CMD ["node", "apps/execution/src/server.js"]
